# ---------------------------------------------------------------------------
# MUJIFX Fundamental Analyst — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel for production.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Every write in the app goes through this key because RLS blocks anon writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data sources ----------------------------------------------------------
# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Used by the legacy /api/sync/all path and the backfill route.
FRED_API_KEY=
# Census (free): https://api.census.gov/data/key_signup.html
# Used by the authoritative retail-sales adapter.
CENSUS_API_KEY=

# BEA UserID (free): https://apps.bea.gov/API/signup/
# REQUIRED for /api/sync/authoritative-gdp and /api/sync/authoritative-pce —
# the BEA API rejects unauthenticated requests. Note the variable is named
# exactly "BEA" (read via process.env["BEA"]), not BEA_API_KEY.
BEA=

# BLS registration key (free): https://data.bls.gov/registrationEngine/
# Optional but strongly recommended: unregistered BLS API v2 requests are
# capped at 25/day and 10 years of history. Variable is named exactly "BLS".
BLS=

# --- Layer 7 AI analyst (optional) -----------------------------------------
# Free key: https://aistudio.google.com/app/apikey
# If unset, the written research note is skipped — the data pipeline still runs.
GEMINI_API_KEY=

# --- Job protection (required in production) --------------------------------
# Every /api/sync/* route requires "Authorization: Bearer $CRON_SECRET".
# Vercel Cron sends this header automatically when CRON_SECRET is set.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- GitHub Actions vintage ingestion (optional) ---------------------------
# Base URL of the deployed app, e.g. https://your-app.vercel.app
VERCEL_VINTAGE_URL=
